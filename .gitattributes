# 文本文件统一用 LF 存储，避免 Windows/Linux 协作时整文件 diff
* text=auto eol=lf

# 二进制（含本项目会产出的图与文档）
*.pdf  binary
*.docx binary
*.png  binary
*.jpg  binary
*.npz  binary
*.zip  binary

# 文档类不做 diff 渲染
*.md   text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.mjs  text eol=lf
*.py   text eol=lf
